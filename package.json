    "check:timers": "node --experimental-strip-types scripts/check-native-timers.mjs",
    "check:customization": "node --experimental-strip-types scripts/check-customization.mjs",
    "check:personalization": "node --experimental-strip-types scripts/check-personalization.mjs",
    "check:feedback": "node --experimental-strip-types scripts/check-ui-feedback.mjs",
    "check:seasons": "node --experimental-strip-types scripts/check-seasons.mjs",
    "check:motion": "node --experimental-strip-types scripts/check-garden-motion.mjs",
    "check:scene-ui": "node --experimental-strip-types scripts/check-scene-ui.mjs",
    "check:character": "node --experimental-strip-types scripts/check-character.mjs",
    "check:crop-wheel": "node --experimental-strip-types scripts/check-crop-wheel.mjs",
    "check:pets": "node --experimental-strip-types scripts/check-pet-art.mjs",
    "check:pet-naming": "node --experimental-strip-types scripts/check-pet-naming.mjs",
    "check:pet-placement": "node --experimental-strip-types scripts/check-pet-placement.mjs"
